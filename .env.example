# ==============================================================================
# PTUK Academic Planner & Schedule Solver - Environment Configuration Template
# ==============================================================================
# CAUTION: Never commit actual production secrets (.env) to version control.
# Generate high-entropy secrets using: openssl rand -hex 32
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://planner.ptuk.edu.ps

# Cryptographic & Session Secrets (MUST be at least 32 characters in production)
SESSION_SECRET=replace_with_64_char_crypto_random_hex_secret
ADMIN_API_KEY=replace_with_strong_admin_api_key
SYNC_API_KEY=replace_with_strong_sync_api_key
STUDENT_AUTH_SECRET=replace_with_strong_internal_auth_secret

# Supabase PostgreSQL Configuration
# Service Role key is strictly used by backend workers; NEVER expose to client!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Public Supabase Client Keys (Anon / Publishable only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
VITE_API_BASE_URL=

# Automated Background Sync Worker Credentials (Edugate Scraper)
PTUK_USERNAME=your_university_sync_service_account
PTUK_PASSWORD=your_university_sync_service_password

# Debugging (Always leave false in production)
DEBUG_SCREENSHOTS=false
